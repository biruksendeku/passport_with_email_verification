# Copy this file to .env and fill in real values

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/passport_demo

# Secret used to sign the express-session cookie
SESSION_SECRET_KEY=change_me

# Gmail account used to send verification emails
# (use a Gmail App Password, not your account password)
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Public base URL used to build verification links
BASE_URL=http://localhost:3000

# Port the server listens on (defaults to 3000)
PORT=3000
